{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Forge Studio Test",
  "version": "0.3.0",
  "identifier": "studio.pixelforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel Forge Studio Test",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 700,
        "backgroundColor": "#25272b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost blob: 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/pixel-forge-mcp.mjs": "automation/pixel-forge-mcp.mjs"
    },
    "category": "GraphicsAndDesign",
    "shortDescription": "A local pixel art and motion workshop",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
